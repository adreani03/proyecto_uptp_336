<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o directorio existe físicamente, sírvelo directamente (para assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Si no existe, enruta todo a index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
